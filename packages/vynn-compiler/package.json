{
  "name": "vynn-compiler",
  "version": "0.0.0",
  "description": "Build-tool-independent Oxc-powered JSX compiler for Vynn",
  "keywords": [
    "compiler",
    "jsx",
    "oxc",
    "vynn"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server-functions": {
      "types": "./dist/server-functions.d.ts",
      "import": "./dist/server-functions.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rolldown --config rolldown.config.ts --configLoader native"
  },
  "dependencies": {
    "@typescript-eslint/types": "^8.72.0",
    "entities": "^8.1.0",
    "esrap": "^2.4.0",
    "oxc-parser": "^0.155.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  }
}
