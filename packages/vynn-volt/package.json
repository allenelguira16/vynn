{
  "name": "@vynn/volt",
  "type": "module",
  "version": "0.0.0",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "NODE_ENV=development rollup -c -w",
    "build": "NODE_ENV=production rollup -c",
    "prepare": "NODE_ENV=development rollup -c",
    "clean": "rimraf dist"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./server": {
      "import": "./dist/esm/server.jsx",
      "require": "./dist/cjs/server.jsx",
      "types": "./dist/types/server.d.ts"
    },
    "./client": {
      "import": "./dist/esm/client.jsx",
      "require": "./dist/cjs/client.jsx",
      "types": "./dist/types/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@vinxi/server-functions": "^0.5.1",
    "vite": "^8.0.14",
    "vite-plugin-vynn": "workspace:^",
    "vite-tsconfig-paths": "^6.1.1",
    "vynn-router": "workspace:^"
  },
  "devDependencies": {
    "@babel/preset-vynn": "workspace:^",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "rollup": "^4.60.4",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-summary": "^3.0.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "^6.0.3",
    "vinxi": "^0.5.11",
    "vite-plugin-vynn": "workspace:^",
    "vynn": "workspace:^"
  },
  "peerDependencies": {
    "vynn": "^0.0.0"
  }
}
