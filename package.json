{
  "name": "vynn-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter \"./packages/**\" exec tsc --noEmit",
    "build": "pnpm --filter app build",
    "check": "pnpm lint && pnpm --filter vynn test:memory && pnpm bench:runtime && pnpm typecheck && pnpm build",
    "bench:size": "node benchmarks/scripts/size.mjs",
    "bench:runtime": "pnpm --filter vynn bench:runtime"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  }
}
