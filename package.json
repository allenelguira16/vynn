{
  "name": "vynn-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "bench:size": "node benchmarks/scripts/size.mjs",
    "build:packages": "pnpm --filter \"./packages/*\" build"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rolldown": "^1.3.3",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "7.1.0-beta"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  }
}
