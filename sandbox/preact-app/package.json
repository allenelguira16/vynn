{
  "name": "preact-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "pnpm build && cross-env NODE_ENV=production tsx server.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "preact": "11.2.0",
    "preact-iso": "2.12.2",
    "preact-render-to-string": "6.8.3",
    "tailwindcss": "^4.3.3",
    "vite-plugin-compression2": "^2.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
